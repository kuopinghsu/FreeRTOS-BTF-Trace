:#333;}#mermaid-zh-tw-1-light div.mermaidTooltip{position:absolute;text-align:center;max-width:200px;padding:2px;font-family:\"trebuchet ms\",verdana,arial,sans-serif;font-size:12px;background:hsl(80, 100%, 96.2745098039%);border:1px solid #aaaa33;border-radius:2px;pointer-events:none;z-index:100;}#mermaid-zh-tw-1-light .flowchartTitleText{text-anchor:middle;font-size:18px;fill:#333;}#mermaid-zh-tw-1-light rect.text{fill:none;stroke-width:0;}#mermaid-zh-tw-1-light .icon-shape,#mermaid-zh-tw-1-light .image-shape{background-color:#FFFFFF;text-align:center;}#mermaid-zh-tw-1-light .icon-shape p,#mermaid-zh-tw-1-light .image-shape p{background-color:#FFFFFF;padding:2px;}#mermaid-zh-tw-1-light .icon-shape .label rect,#mermaid-zh-tw-1-light .image-shape .label rect{opacity:0.5;background-color:#FFFFFF;fill:#FFFFFF;}#mermaid-zh-tw-1-light .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#mermaid-zh-tw-1-light .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#mermaid-zh-tw-1-light :root{--mermaid-font-family:\"trebuchet ms\",verdana,arial,sans-serif;}</style><g><marker id=\"mermaid-zh-tw-1-light_flowchart-v2-pointEnd\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M 0 0 L 10 5 L 0 10 z\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"/></marker><marker id=\"mermaid-zh-tw-1-light_flowchart-v2-pointStart\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"4.5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M 0 5 L 10 10 L 10 0 z\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"/></marker><marker id=\"mermaid-zh-tw-1-light_flowchart-v2-circleEnd\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"11\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"11\" m