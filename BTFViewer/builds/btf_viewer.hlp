aid-zh-tw-0-dark .labelBkg{background-color:rgba(30, 30, 30, 0.5);}#mermaid-zh-tw-0-dark .cluster rect{fill:hsl(180, 1.5873015873%, 28.3529411765%);stroke:rgba(255, 255, 255, 0.25);stroke-width:1px;}#mermaid-zh-tw-0-dark .cluster text{fill:#F9FFFE;}#mermaid-zh-tw-0-dark .cluster span{color:#F9FFFE;}#mermaid-zh-tw-0-dark div.mermaidTooltip{position:absolute;text-align:center;max-width:200px;padding:2px;font-family:\"trebuchet ms\",verdana,arial,sans-serif;font-size:12px;background:hsl(20, 1.5873015873%, 12.3529411765%);border:1px solid rgba(255, 255, 255, 0.25);border-radius:2px;pointer-events:none;z-index:100;}#mermaid-zh-tw-0-dark .flowchartTitleText{text-anchor:middle;font-size:18px;fill:#ccc;}#mermaid-zh-tw-0-dark rect.text{fill:none;stroke-width:0;}#mermaid-zh-tw-0-dark .icon-shape,#mermaid-zh-tw-0-dark .image-shape{background-color:#1E1E1E;text-align:center;}#mermaid-zh-tw-0-dark .icon-shape p,#mermaid-zh-tw-0-dark .image-shape p{background-color:#1E1E1E;padding:2px;}#mermaid-zh-tw-0-dark .icon-shape .label rect,#mermaid-zh-tw-0-dark .image-shape .label rect{opacity:0.5;background-color:#1E1E1E;fill:#1E1E1E;}#mermaid-zh-tw-0-dark .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#mermaid-zh-tw-0-dark .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#mermaid-zh-tw-0-dark :root{--mermaid-font-family:\"trebuchet ms\",verdana,arial,sans-serif;}</style><g><marker id=\"mermaid-zh-tw-0-dark_flowchart-v2-pointEnd\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><path d=\"M 0 0 L 10 5 L 0 10 z\" class=\"arrowMarkerPath\" style=\"stroke-width: 1; stroke-dasharray: 1, 0;\"/></marker><marker id=\"mermaid-zh-tw-0-dark_flowchart-v2-pointStart\" class=\"marker flowchart-v2\" viewBox=\"0 0 10 10\" refX=\"4.5\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\"><p