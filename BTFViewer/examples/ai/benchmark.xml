<?xml version="1.0" encoding="UTF-8"?>
<!--
  Live AI benchmark suite for Desktop ai-test.

  From BTFViewer/:
    python builds/btf_viewer.py ai-test -c examples/ai/benchmark.xml
    make ai-test-live
    make ai-test-context
  Optional models are skipped when their key is missing. To force them:
    make ai-test-context AI_MODELS=claude-sonnet-5,kimi-k3
  Live model calls retry up to 3 times on high demand / timeouts.

  Copy this file and edit <base-url>, <model id>, and keys for your lab.
  Do not commit real API keys. Prefer env="VARNAME" and leave the element empty.
  Filter models: pass models=id1,id2 on the ai-test command (ids from this file).
  Self-signed / private-CA TLS: <tls-verify>false</tls-verify> (default below).
  Public HTTPS models can override to true.
-->
<ai-benchmark version="1">
  <dataset>tests/ai</dataset>
  <fail-under>0</fail-under>
  <output>AI_BENCHMARK.md</output>

  <!-- Defaults for every <model> that does not override them. -->
  <endpoint>
    <base-url>http://localhost:11434/v1</base-url>
    <tls-verify>false</tls-verify>
    <timeout-s>600</timeout-s>
    <!-- Local Ollama needs no key. Uncomment if the proxy requires one:
    <api-key env="OLLAMA_API_KEY"/>
    -->
  </endpoint>

  <models>
    <model id="qwen3.5:9b"/>
    <model id="qwen3.8:27b"/>

    <!-- Gemini: same provider, two ids. They share URL and GEMINI_API_KEY.
         Both:  -m gemini-3.7-flash,gemini-3.5-flash-lite -->
    <model id="gemini-3.7-flash" preset="gemini">
      <base-url>https://generativelanguage.googleapis.com/v1beta/openai</base-url>
      <tls-verify>true</tls-verify>
      <timeout-s>300</timeout-s>
      <api-key env="GEMINI_API_KEY"/>
    </model>
    <model id="gemini-3.5-flash-lite" preset="gemini">
      <base-url>https://generativelanguage.googleapis.com/v1beta/openai</base-url>
      <tls-verify>true</tls-verify>
      <timeout-s>300</timeout-s>
      <api-key env="GEMINI_API_KEY"/>
    </model>

    <!-- Optional cloud models: skipped unless the env key is set.
         Force with models=claude-sonnet-5,kimi-k3 -->
    <model id="claude-sonnet-5" preset="claude" optional="true">
      <base-url>https://api.anthropic.com/v1</base-url>
      <tls-verify>true</tls-verify>
      <timeout-s>300</timeout-s>
      <api-key env="ANTHROPIC_API_KEY"/>
    </model>
    <model id="kimi-k3" preset="kimi" optional="true">
      <base-url>https://api.moonshot.ai/v1</base-url>
      <tls-verify>true</tls-verify>
      <timeout-s>300</timeout-s>
      <api-key env="MOONSHOT_API_KEY"/>
    </model>
  </models>
</ai-benchmark>
