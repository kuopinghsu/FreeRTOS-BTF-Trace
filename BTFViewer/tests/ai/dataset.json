{
  "schema": "btf-ai-benchmark",
  "version": 1,
  "description": "Expected-facts cases for offline ai-test (and future live model runs). Traces sit next to this file.",
  "cases": [
    {
      "id": "migration_thrash",
      "trace": "migration_thrash.btf",
      "question": "Why is CS[22] bouncing between cores?",
      "expected": {
        "finding_types": ["migration", "thrash"],
        "tasks": ["CS[22]"],
        "root_cause_class": "affinity",
        "evidence": { "required_metrics": ["migrations"] },
        "allowed_tools": ["detect_anomalies", "investigate", "correlate_events", "query_raw_metric"],
        "forbidden": {
          "invented_task_names": true,
          "out_of_scope_timestamps": true
        },
        "pass_under": 70
      },
      "catalog": {
        "tasks": ["CS[22]", "Idle[0]"],
        "times": [1083000],
        "cursor_lo": 1000000,
        "cursor_hi": 1200000
      },
      "tools": ["investigate", "correlate_events", "query_raw_metric"],
      "response": "CS[22] shows migration thrash around jump:1083000. Migrations bounce Core_0 ↔ Core_1; likely missing affinity. Confidence: Medium."
    },
    {
      "id": "mutex_contention",
      "trace": "mutex_contention.btf",
