# btf_viewer.rc - RTOS BTF Viewer settings
# This file is managed automatically; you may edit it by hand.

[window]
width = 1916
height = 1088
x = 254
y = 47
maximized = false
dock_state = 
dock_metrics = 
dock_layout_version = 10

[view]
font_size = 8
theme = dark
horizontal = true
view_mode = task
show_sti = true
show_grid = true
show_legend = true
show_stats = true
show_marks = true
show_find = true

[zoom]
timescale_per_px = -1

[cursors]
positions = 

[files]
last_file = 
last_dir = /home/kuoping
open_tabs_json = []
active_tab_index = 0

[app]
icon_path = 

[analysis]
cpu_budget_pct = 0
task_deadlines = 

