{
  "name": "btf-viewer",
  "version": "1.3.2",
  "description": "Web-based RTOS BTF Viewer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/embed-wasm.mjs && vite build",
    "wasm": "wat2wasm wasm/timeline_accel.wat -o src/renderer/timeline_accel.wasm && node scripts/embed-wasm.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bz2": "^1.0.1",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "pixi.js": "^8.19.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "playwright": "^1.52.0",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
