<?xml version="1.0" encoding="UTF-8"?>
<!--
  BTFViewer demo script (in-app overlay tour).

  Run (from BTFViewer/):
    make demo
    # or: python3 builds/btf_viewer.py demos/demo_8cores/demo_8cores.xml
    Note: XML comments must not contain double-hyphen sequences.
    Open or drop this XML, the folder, or a packed .xtf in Desktop or Web.
    Toolbar icons, tabs, Analysis, and Find are demo API events, not overlay clicks.

  Trace snapshot: demo_8cores.btf.gz (frozen copy in this demo folder;
  do not point at tracedata/example-8cores.btf.gz — that file may change).
  Narration: text/{lang}/*.txt → voice/{lang}/*.mp3 (see scripts/demo_voice.py)
  TTS tip: write Free-RTOS (with hyphen) so speech engines say it correctly.
  Variables: REPO, BTF, PYTHON, MOD, XML_DIR, trace, cwd (as ${name})
-->
<demo name="BTFViewer demo 8cores" version="1">

  <meta>
    <title>BTFViewer demo — 8-core sample</title>
    <description>
      Screen-capture + pre-rendered TTS. Order follows WORKFLOWS.md
      (find evidence, then explain): UI → Analysis → Health → Scope →
      Balance → WCET → Latency → Concurrency → Compliance → Export/Compare →
      AI for newbies (Settings, Start Investigation, verify jumps,
      Explain region). Trace: demo_8cores.btf.gz (frozen demo snapshot).
    </description>
    <cwd>${BTF}</cwd>
    <trace>${XML_DIR}/demo_8cores.btf.gz</trace>
    <languages default="en">
      <language id="en" label="English"/>
      <language id="zh-tw" label="中文"/>
    </languages>
<launch cwd="${BTF}" cmd="${PYTHON} builds/btf_viewer.py ${trace}"/>
  </meta>

  <defaults after_voice="1.5" pause="0.8" ai_wait="35" move_duration="0.35" audio_block="false"/>

  <targets>
    <!-- x/y are fractions of the detected BTFViewer window (0..1), not the screen -->
    <point name="timeline" x="0.19" y="0.30"/>
    <point name="timeline_bar" x="0.47" y="0.78"/>
    <point name="status" x="0.35" y="0.965"/>
    <point name="stats_panel" x="0.84" y="0.20"/>
    <point name="stats_summary" x="0.84" y="0.20"/>
    <point name="stats_tab" x="0.78" y="0.12"/>
    <point name="find_tab" x="0.85" y="0.12"/>
    <point name="ai_tab" x="0.92" y="0.12"/>
    <point name="load_strip" x="0.45" y="0.72"/>
    <point name="toolbar_open" x="0.025" y="0.055"/>
    <point name="toolbar_analysis" x="0.62" y="0.055"/>
    <point name="toolbar_settings" x="0.78" y="0.055"/>
    <point name="toolbar_1to1" x="0.26" y="0.055"/>
    <point name="toolbar_fit" x="0.28" y="0.055"/>
    <point name="toolbar_core" x="0.40" y="0.055"/>
    <point name="toolbar_task" x="0.37" y="0.055"/>
    <point name="toolbar_load" x="0.43" y="0.055"/>
    <point name="toolbar_heatmap" x="0.48" y="0.055"/>
    <point name="toolbar_find" x="0.52" y="0.055"/>
    <point name="limit_checkbox" x="0.82" y="0.16"/>
    <point name="stats_export_html" x="0.88" y="0.94"/>
    <point name="stats_health" x="0.84" y="0.32"/>
    <point name="stats_tick_dist" x="0.90" y="0.40"/>
  </targets>

  <macros>
    <macro name="fit">
      <hotkey keys="mod+0"/>
    </macro>
    <macro name="clear_cursors">
      <hotkey keys="shift+c"/>
    </macro>
    <macro name="clear_bookmarks">
      <hotkey keys="shift+b"/>
    </macro>
    <macro name="clear_annotations">
      <hotkey keys="shift+a"/>
    </macro>
    <macro name="place_cursor">
      <!-- params: time (seconds, e.g. 3.085) -->
      <hotkey keys="mod+g"/>
      <wait seconds="0.6" why="Jump to Time dialog"/>
      <hotkey keys="mod+a"/>
      <type text="${time} s"/>
      <press key="enter"/>
      <wait seconds="0.8" why="jump settle"/>
      <press key="c"/>
      <wait seconds="0.4" why="cursor placed"/>
    </macro>
    <macro name="settings">
      <hotkey keys="mod+,"/>
    </macro>
  </macros>

  <steps>

    <step id="1" title="Title" tags="intro">
      <focus/>
      <clear_cursors/>
      <clear_bookmarks/>
      <clear_annotations/>
      <clear_highlight/>
      <view_mode mode="task"/>
      <zoom_view/>
      <move_view time="0"/>
      <wait seconds="1" why="title hold"/>
      <audio file="${XML_DIR}/voice/01_title.mp3"/>
      <show_message text="Welcome to BTFViewer Demo" seconds="3"/>
      <wait seconds="9"/>
      <move target="stats_summary"/>
      <wait seconds="2"/>
      <show_message text="Span: 2.421 s / Tasks: 163 / Cores: 8" seconds="10"/>
    </step>

    <step id="2" title="Open example-8cores" tags="intro">
      <focus/>
      <audio file="${XML_DIR}/voice/02_open.mp3"/>
      <move target="toolbar_open"/>
      <show_message text="Open File" seconds="3"/>
      <macro ref="fit"/>
      <wait seconds="2" why="fit after open"/>
    </step>

    <step id="3" title="Timeline canvas" tags="ui">
      <focus/>
      <audio file="${XML_DIR}/voice/03_timeline.mp3"/>
      <zoom_view/>
      <zoom_in/>
      <zoom_in/>
      <move target="timeline" duration="3"/>
      <wait seconds="2.0"/>
      <move target="timeline_bar" duration="3"/>
      <wait seconds="9.0" why="hover tooltip"/>
      <move target="status" duration="0.5"/>
      <wait seconds="0.6"/>
    </step>

    <step id="4" title="Toolbar tour" tags="ui">
      <focus/>
      <view_mode mode="task"/>
      <audio file="${XML_DIR}/voice/04_toolbar.mp3"/>
      <wait seconds="5.0" why="voice: icons H/V zoom to Task/Core"/>
      <wait seconds="2.5"/>
      <move target="toolbar_fit"/>
      <wait seconds="2.5"/>
      <move target="toolbar_task"/>
      <wait seconds="2.0" why="voice: Task view"/>
      <move target="toolbar_core"/>
      <wait seconds="1.0" why="voice: Core view"/>
      <move target="toolbar_load"/>
      <wait seconds="2.25"/>
      <move target="toolbar_heatmap"/>
      <wait seconds="3.00"/>
      <cpu_load on="true"/>
      <wait seconds="5.2" why="voice: Load Heatmap Chord into Analysis"/>
      <move target="toolbar_analysis"/>
      <wait seconds="5" why="voice: Analysis triage card"/>
      <wait seconds="3.25"/>
      <move target="stats_tab"/>
      <panel name="stats"/>
      <wait seconds="2.5" why="voice: right panel tabs"/>
      <move target="find_tab"/>
      <wait seconds="0.25"/>
      <panel name="find"/>
      <wait seconds="0.25"/>
      <move target="ai_tab"/>
      <wait seconds="0.25"/>
      <panel name="ai"/>
      <wait seconds="0.25"/>
      <move target="stats_tab"/>
      <wait seconds="0.25"/>
      <panel name="stats"/>
      <wait_audio/>
    </step>

    <step id="5" title="Task Core Load" tags="ui">
      <focus/>
      <audio file="${XML_DIR}/voice/05_views.mp3"/>
      <cpu_load on="true"/>
      <wait seconds="2.0" why="voice: Load strip"/>
      <move target="toolbar_core"/>
      <wait seconds="0.25"/>
      <view_mode mode="core"/>
      <show_message text="Core View" seconds="3"/>
      <wait seconds="3.0" why="voice: Core view"/>
      <move target="toolbar_task"/>
      <wait seconds="0.25"/>
      <view_mode mode="task"/>
      <show_message text="Task View" seconds="3"/>
      <wait seconds="1.5" why="voice: Task view"/>
      <wait_audio/>
    </step>

    <step id="6" title="Fit" tags="ui">
      <focus/>
      <audio file="${XML_DIR}/voice/06_fit.mp3"/>
      <move target="toolbar_1to1"/>
      <wait seconds="0.25"/>
      <zoom_1to1/>
      <wait seconds="1.0"/>
      <move target="toolbar_fit"/>
      <wait seconds="0.25"/>
      <zoom_view/>
      <wait seconds="1.0"/>
    </step>

    <step id="7" title="Statistics Summary" tags="ladder">
      <focus/>
      <move target="stats_tab"/>
      <wait seconds="0.25"/>
      <panel name="stats"/>
      <move target="stats_summary"/>
      <wait seconds="0.4"/>
      <stats_section id="cores" expand="true" collapse_others="true" scroll="top"/>
      <audio file="${XML_DIR}/voice/07_summary.mp3"/>
      <wait_audio/>
      <stats_reset/>
    </step>

    <step id="8" title="Analysis Findings" tags="ladder">
      <focus/>
      <audio file="${XML_DIR}/voice/08_analysis.mp3"/>
      <wait seconds="2.5" why="voice: Click Analysis on the toolbar"/>
      <move target="toolbar_analysis"/>
      <wait seconds="0.25"/>
      <analysis/>
      <wait_audio/>
      <analysis close="true"/>
      <wait seconds="0.6"/>
    </step>

    <step id="9" title="Trace Health" tags="ladder">
      <focus/>
      <panel name="stats"/>
      <move target="stats_health"/>
      <wait seconds="0.25"/>
      <stats_section id="health" expand="true" collapse_others="true"/>
      <audio file="${XML_DIR}/voice/09_tick.mp3"/>
      <move target="stats_tick_dist"/>
      <wait seconds="0.25"/>
      <tick_dist/>
      <wait seconds="10.0"/>
      <tick_dist close="true"/>
      <wait_audio/>
      <stats_reset/>
    </step>

    <step id="10" title="Cursors Limit C1-Cn" tags="ladder">
      <focus/>
      <audio file="${XML_DIR}/voice/10_cursors.mp3"/>
      <zoom_view/>
      <clear_cursors/>
      <cursors times="3.085,3.310" unit="s" limit="true" zoom="true"/>
      <fit_view/>
      <zoom_out/>
      <clear_highlight/>
      <tab_nav/>
      <wait seconds="1.5"/>
      <wait_audio/>
      <clear_cursors/>
    </step>

    <step id="11" title="Core Utilisation" tags="ladder">
      <focus/>
      <panel name="stats"/>
      <stats_section id="cores" expand="true" collapse_others="true"/>
      <audio file="${XML_DIR}/voice/11_balance.mp3"/>
      <wait_audio/>
      <stats_reset/>
    </step>

    <step id="12" title="Top Tasks WCET" tags="ladder">
      <focus/>
      <panel name="stats"/>
      <stats_section id="tasks,exec" expand="true" collapse_others="true" scroll="exec"/>
      <audio file="${XML_DIR}/voice/12_wcet.mp3"/>
      <highlight task="NC[118]"/>
      <wait seconds="0.8"/>
      <jump_wcet task="NC[118]"/>
      <wait seconds="2.0" why="WCET jump settle"/>
      <wait_audio/>
      <clear_highlight/>
      <stats_reset/>
    </step>

    <step id="13" title="Blocking Inheritance" tags="ladder">
      <focus/>
      <zoom_view/>
      <clear_cursors/>
      <clear_annotations/>
      <cursors times="3.085,3.310" unit="s" limit="true" zoom="true"/>
      <panel name="stats"/>
      <stats_section id="block,priority,preemption" expand="true" collapse_others="true" scroll="block"/>
      <move target="timeline"/>
      <wait seconds="0.6"/>
      <audio file="${XML_DIR}/voice/13_latency.mp3"/>
      <highlight task="High"/>
      <wait seconds="1.2"/>
      <highlight task="Med"/>
      <wait seconds="1.0"/>
      <highlight task="Low"/>
      <wait seconds="1.5"/>
      <wait_audio/>
      <stats_reset/>
      <clear_cursors/>
    </step>

    <step id="14" title="Migrations Mutex" tags="ladder">
      <focus/>
      <audio file="${XML_DIR}/voice/14_migrations.mp3"/>
      <limit on="false"/>
      <clear_cursors/>
      <zoom_view/>
      <panel name="stats"/>
      <stats_section id="migrations,sync,queue" expand="true" collapse_others="true" scroll="migrations"/>
      <highlight task="CS[18]"/>
      <wait seconds="2.0"/>
      <wait_audio/>
      <clear_highlight/>
      <stats_reset/>
    </step>

    <step id="15" title="Affinity Lifecycle" tags="ladder">
      <focus/>
      <panel name="stats"/>
      <stats_section id="affinity,lifecycle" expand="true" collapse_others="true" scroll="affinity"/>
      <highlight task="SR0"/>
      <audio file="${XML_DIR}/voice/15_compliance.mp3"/>
      <wait_audio/>
      <clear_highlight/>
      <stats_reset/>
    </step>

    <step id="16" title="Find" optional="true" tags="ui,optional">
      <focus/>
      <audio file="${XML_DIR}/voice/16_find.mp3"/>
      <move target="find_tab"/>
      <wait seconds="0.25"/>
      <find query="CS[27]"/>
      <wait_audio/>
      <find clear="true"/>
    </step>

    <step id="17" title="Export" tags="ui">
      <focus/>
      <zoom_view/>
      <move_view time="0"/>
      <panel name="stats"/>
      <wait seconds="0.25"/>
      <move target="stats_export_html"/>
      <wait seconds="0.4"/>
      <confirm prompt="Point at Export HTML — then continue"/>
      <audio file="${XML_DIR}/voice/17_export.mp3"/>
    </step>

    <step id="18" title="AI setup" tags="ai">
      <focus/>
      <move target="ai_tab"/>
      <wait seconds="0.25"/>
      <panel name="ai"/>
      <audio file="${XML_DIR}/voice/18_ai_setup.mp3"/>
      <wait seconds="16" why="voice: open Settings AI"/>
      <settings page="AI"/>
      <wait_audio/>
      <settings close="true"/>
    </step>

    <step id="19" title="AI Start Investigation" tags="ai">
      <focus/>
      <panel name="ai"/>
      <audio file="${XML_DIR}/voice/19_ai_start.mp3"/>
      <confirm prompt="Empty AI log: click Start Investigation (example ~20s, 11 tools); Apply cards if shown — then continue"/>
      <wait ai="true" seconds="25" why="auto investigate (~20s flash-lite example)"/>
    </step>

    <step id="20" title="AI verify jumps" tags="ai">
      <focus/>
      <panel name="ai"/>
      <audio file="${XML_DIR}/voice/20_ai_verify.mp3"/>
      <confirm prompt="Click every jump:TIME in the reply and confirm it on the timeline — then continue"/>
    </step>

    <step id="21" title="AI Explain region" tags="ai">
      <focus/>
      <audio file="${XML_DIR}/voice/21_ai_explain.mp3"/>
      <zoom_view/>
      <clear_cursors/>
      <cursors times="3.085,3.310" unit="s" limit="true" zoom="true"/>
      <panel name="ai"/>
      <confirm prompt="Limit ON; click Explain region; every jump must land inside C1–Cn — then continue"/>
      <wait ai="true" why="explain region"/>
      <limit on="false"/>
      <clear_cursors/>
    </step>

    <step id="22" title="Close" tags="intro">
      <focus/>
      <macro ref="fit"/>
      <audio file="${XML_DIR}/voice/22_close.mp3"/>
      <wait seconds="3" why="end hold"/>
    </step>

  </steps>
</demo>
